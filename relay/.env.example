# Copy to .env and fill in the first three. Everything else has a sensible default.

# The public name of this relay (a DNS name pointing at this machine or your router).
RELAY_HOST=relay.example.org

# A long random secret shared by the relay and the TURN server. Never leaves this machine.
#   openssl rand -hex 32
TURN_SECRET=

# A code people must enter in the app (Settings -> My relay -> Access code) before this relay
# lets them route connections through your TURN server, which uses your bandwidth.
# Share it with the people you want to help. Leave empty to let anyone who knows the address use it.
ACCESS_CODE=

# ---- optional ----

# Your public IP address, if the automatic detection gets it wrong (e.g. behind two routers).
# EXTERNAL_IP=203.0.113.7

# Port the relay listens on, on this machine (put your HTTPS proxy in front of it, or use the
# built-in one: see README).
# RELAY_PORT=7777

# UDP ports the TURN server relays through. Forward these, plus 3478 (UDP and TCP), on your router.
# TURN_MIN_PORT=49160
# TURN_MAX_PORT=49200

# How long mailbox messages wait for their recipient, and how much may be stored in total.
# MAIL_TTL_DAYS=8
# MAX_STORED_MB=100
